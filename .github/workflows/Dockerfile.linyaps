ARG BASE_IMAGE=linuxdeepin/deepin:crimson
FROM ${BASE_IMAGE}

# Add linyaps OBS repository
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        gnupg \
    && echo "deb [trusted=yes] https://ci.deepin.com/repo/obs/linglong:/CI:/release/Deepin_25/ ./" \
        > /etc/apt/sources.list.d/linglong.list \
    && apt-get update && \
    apt-get install -y --no-install-recommends \
        linglong-builder \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . /build

# Build the linyaps package
# ll-builder needs a network connection to pull the base/runtime layers on first run.
# The --offline flag can be used if layers are pre-cached.
RUN ll-builder build --arch $(dpkg --print-architecture) && \
    ll-builder export && \
    mkdir -p /output && \
    cp *.uab /output/

CMD ["/bin/bash"]
